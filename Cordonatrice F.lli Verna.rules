
(rules PCB Cordonatrice F.lli Verna.dsn
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 1)
    (layer_rule F.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.6)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 3.4)
    )
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 200.0 (type "kicad_default"))
  )
  (padstack "Via[0-1]_600:400_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:400_um" "Via[0-1]_600:400_um" default
  )
  (via 
    "Via[0-1]_600:400_um-kicad_default" "Via[0-1]_600:400_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_600:400_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:400_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    GND +5V +24V "Net-(J1-Pad2)" "Net-(J2-Pad2)" "Net-(J3-Pad2)" "Net-(J4-Pad2)" "STEP_PIN_X"
    "DIR_PIN_X" "ENABLE_PIN_X" "STEP_PIN_Y" "ENABLE_PIN_Y" "DIR_PIN_Y" +3.3V "POT_M1" "POT_M2"
    "BT_START" "BT_STOP" "BT_PAUSE" SDA SCL "Net-(J14-Pad2)" "Net-(J14-Pad1)" "unconnected-(K1-Pad11)"
    "unconnected-(K1-Pad6)" "Net-(D1-K)" "unconnected-(K1-Pad4)" "unconnected-(K1-Pad8)" "Net-(Q1-B)" "rele_fiaccola" "LIMIT_X_MIN" "LIMIT_X_MAX"
    "LIMIT_Y_MIN" "LIMIT_Y_MAX" "unconnected-(U2-A8-Pad8)" "unconnected-(U2-B8-Pad11)" "DIR_X_MIC." "ENBL_Y_MIC." "STEP_X_MIC." "unconnected-(U2-B7-Pad12)"
    "unconnected-(U2-A7-Pad7)" "ENBL_X_MIC." "STEP_Y_MIC." "DIR_Y_MIC." "unconnected-(U3-GND1-PadJ2-14)" "unconnected-(U3-IO2-PadJ3-15)" "unconnected-(U3-CLK-PadJ3-19)" "unconnected-(U3-IO17-PadJ3-11)"
    "unconnected-(U3-SD2-PadJ2-16)" "unconnected-(U3-CMD-PadJ2-18)" "unconnected-(U3-IO0-PadJ3-14)" "unconnected-(U3-EN-PadJ2-2)" "unconnected-(U3-SD3-PadJ2-17)" "unconnected-(U3-GND2-PadJ3-7)" "unconnected-(U3-SD1-PadJ3-17)" "unconnected-(U3-IO23-PadJ3-2)"
    "unconnected-(U3-IO16-PadJ3-12)" "unconnected-(U3-TXD0-PadJ3-4)" "unconnected-(U3-SD0-PadJ3-18)" "unconnected-(U3-IO18-PadJ3-9)" "unconnected-(U3-IO19-PadJ3-8)" "Net-(U1-VO)"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)